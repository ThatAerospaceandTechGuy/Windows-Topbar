<Window x:Class="TopBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar Settings"
        Width="620" Height="520"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="CardBgHover" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="NavIconBlue" Color="#0A84FF"/>
        <SolidColorBrush x:Key="NavIconPurple" Color="#AF52DE"/>
        <SolidColorBrush x:Key="NavIconGreen" Color="#34C759"/>

        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PopupHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PopupFgBright}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="NavIconBox" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardSep" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupSeparator}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,9"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PopupFgBright}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                    CornerRadius="10,0,0,10" Padding="10,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Settings"
                               Style="{StaticResource PopupHeader}" Margin="8,0,0,14"/>
                    <StackPanel>
                        <Border x:Name="TabGeneral" Style="{StaticResource NavItem}"
                                Background="{DynamicResource PopupAccent}" Tag="General"
                                MouseLeftButtonUp="Tab_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource NavIconBox}" Background="{StaticResource NavIconBlue}">
                                    <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/>
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource NavLabel}" Text="General"/>
                            </Grid>
                        </Border>

                        <Border x:Name="TabAppearance" Style="{StaticResource NavItem}" Tag="Appearance"
                                MouseLeftButtonUp="Tab_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource NavIconBox}" Background="{StaticResource NavIconPurple}">
                                    <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;"/>
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource NavLabel}" Text="Appearance"/>
                            </Grid>
                        </Border>

                        <Border x:Name="TabModules" Style="{StaticResource NavItem}" Tag="Modules"
                                MouseLeftButtonUp="Tab_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource NavIconBox}" Background="{StaticResource NavIconGreen}">
                                    <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71D;"/>
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource NavLabel}" Text="Modules"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Content ── -->
            <DockPanel Grid.Column="1">
                <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" Text="General"
                           Style="{StaticResource PopupHeader}" Margin="20,18,20,12"/>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PopupSeparator}"
                        Height="1" Margin="20,0,20,0"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="20,14,20,16">
                    <Grid>
                        <!-- General -->
                        <StackPanel x:Name="PanelGeneral">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Bar Name" Style="{StaticResource PopupSection}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="NameBox"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Don't hide top bar" Style="{StaticResource SettingLabel}"/>
                                        <CheckBox x:Name="AlwaysVisibleCheckBox" Grid.Column="1"/>
                                    </Grid>
                                    <Border Style="{StaticResource CardSep}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Push windows down" Style="{StaticResource SettingLabel}"/>
                                        <CheckBox x:Name="PushCheckBox" Grid.Column="1"/>
                                    </Grid>
                                    <Border Style="{StaticResource CardSep}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Run at startup" Style="{StaticResource SettingLabel}"/>
                                        <CheckBox x:Name="StartupCheckBox" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PopupSection}" Margin="0,0,0,6">
                                        <Run Text="Reveal delay: "/><Run x:Name="DelayLabel" Text="500"/><Run Text=" ms"/>
                                    </TextBlock>
                                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="1000"
                                            TickFrequency="50" IsSnapToTickEnabled="True"
                                            ValueChanged="DelaySlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Keyboard shortcut" Style="{StaticResource PopupSection}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="ShortcutBox" ToolTip="e.g. Ctrl+Shift+T"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Animate popups (slide)" Style="{StaticResource SettingLabel}"/>
                                    <CheckBox x:Name="AnimateCheckBox" Grid.Column="1"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Bar color" Style="{StaticResource PopupSection}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorPreview" Width="30" Height="30"
                                                CornerRadius="6" BorderBrush="{DynamicResource PopupInputBorder}" BorderThickness="1"
                                                Background="#BF000000" Margin="0,0,10,0" Cursor="Hand"
                                                MouseLeftButtonUp="ColorPreview_Click"
                                                ToolTip="Click to pick a colour"/>
                                        <TextBox x:Name="ColorBox" Width="120" VerticalAlignment="Center"
                                                 TextChanged="ColorBox_TextChanged"
                                                 ToolTip="#AARRGGBB hex color"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Presets" Style="{StaticResource PopupSection}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF000000" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF000000"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF1A1A2E" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF1A1A2E"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF0D1B2A" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF0D1B2A"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF1B2D1A" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF1B2D1A"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF2D1A1A" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF2D1A1A"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF2D2A1A" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF2D2A1A"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF1A2D2D" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF1A2D2D"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#BF2D1A2D" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#BF2D1A2D"/>
                                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,6,6"
                                                Background="#60FFFFFF" Cursor="Hand" MouseLeftButtonUp="Preset_Click" Tag="#60FFFFFF"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Modules -->
                        <StackPanel x:Name="PanelModules" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Window Title (centre)" Style="{StaticResource SettingLabel}"/>
                                    <CheckBox x:Name="ModWindowTitle" Grid.Column="1"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Right-side items  (top = leftmost on bar)"
                                               Style="{StaticResource PopupSection}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Toggle and drag to reorder bar items."
                                               Foreground="{DynamicResource PopupFgLabel}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ListBox x:Name="LayoutList"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource PopupFgBright}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="LayoutList_PreviewMouseDown"
                                             PreviewMouseMove="LayoutList_PreviewMouseMove"
                                             Drop="LayoutList_Drop">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PopupFgBright}"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource RowRadius}" Padding="8,6"
                                                                    Margin="{TemplateBinding Margin}">
                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PopupAccent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PopupHoverBg}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
