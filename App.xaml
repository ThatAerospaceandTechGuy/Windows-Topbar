<Application x:Class="TopBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══════════════════════════════════════════════════════════
                 DESIGN TOKENS — single source of truth for popup chrome.
                 Runtime color brushes (PopupFg*, PopupAccent, …) are
                 injected by MainWindow.UpdatePopupResources so every
                 surface follows the bar color / light-dark contrast.
                 ═══════════════════════════════════════════════════════════ -->
            <CornerRadius x:Key="PopupRadius">10</CornerRadius>
            <CornerRadius x:Key="PillRadius">8</CornerRadius>
            <CornerRadius x:Key="RowRadius">6</CornerRadius>
            <Thickness x:Key="ContentPad">16,14</Thickness>

            <!-- Popup title (top of every panel) -->
            <Style x:Key="PopupHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PopupFgBright}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Section label inside a panel -->
            <Style x:Key="PopupSection" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PopupFgLabel}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>

            <!-- Small rounded button (Border + text), used across panels -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PopupButtonBg}"/>
                <Setter Property="CornerRadius" Value="{StaticResource PillRadius}"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PopupHoverBg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Top-bar menu tab (File / Edit / View / Window / Help) -->
            <Style x:Key="MenuTab" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="{StaticResource RowRadius}"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Generic top-bar hover cell (app button, status icons) -->
            <Style x:Key="BarCell" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="{StaticResource RowRadius}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Slim dark scrollbar for popups (thumb-drag + wheel; no arrow buttons) -->
            <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource PopupFgLabel}" Opacity="0.55" CornerRadius="4" Margin="3,2,1,2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Slider — thin macOS track + round thumb ═══ -->
            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{DynamicResource PopupFgNormal}"/>
                <Setter Property="MinHeight" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource PopupAccent}" Margin="6,0"/>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="14" Height="14"
                                                             Fill="{DynamicResource PopupThumb}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ CheckBox — accent fill, dark friendly ═══ -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource PopupFgBright}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource PopupInputBg}"
                                        BorderBrush="{DynamicResource PopupInputBorder}"
                                        BorderThickness="1">
                                    <Viewbox x:Name="Tick" Width="11" Height="11"
                                             Visibility="Collapsed">
                                        <Path Data="M2.5 6.5 L5 9 L9 3"
                                              Stroke="{DynamicResource PopupInputBg}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource PopupThumb}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PopupThumb}"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PopupFgNormal}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Button — rounded pill ═══ -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PopupFgNormal}"/>
                <Setter Property="Background" Value="{DynamicResource PopupButtonBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PopupInputBorder}"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="{StaticResource PillRadius}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PopupFgNormal}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Text / password inputs — dark friendly ═══ -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource PopupInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource PopupInputFg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PopupInputBorder}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PopupInputFg}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource PopupAccent}"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource PopupInputBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource PopupInputFg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PopupInputBorder}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PopupInputFg}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
