<Window x:Class="TopBar.BluetoothPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth"
        Width="364" SizeToContent="Height" MaxHeight="624"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}" Padding="{StaticResource ContentPad}">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bluetooth" Style="{StaticResource PopupHeader}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" x:Name="ToggleButton" Style="{StaticResource Pill}"
                        MouseLeftButtonUp="Toggle_Click">
                    <TextBlock x:Name="ToggleText" Foreground="{DynamicResource PopupFgNormal}" FontSize="12"/>
                </Border>
            </Grid>

            <Border Background="{DynamicResource PopupSeparator}" Height="1" Margin="0,0,0,10"/>

            <TextBlock x:Name="StatusText" Text="…"
                       Foreground="{DynamicResource PopupFgBright}" FontSize="12.5"
                       Margin="0,0,0,8"/>

            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DeviceHost"/>
            </ScrollViewer>

            <StackPanel x:Name="FooterHost" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
