<Window x:Class="TopBar.AppleMenuPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Menu"
        Width="324" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}" Padding="8,8">
        <StackPanel x:Name="ItemHost">
            <TextBlock Text="This PC" Style="{StaticResource PopupSection}" Margin="8,2,8,8"/>
            <TextBlock x:Name="AboutText" Text="Gathering system info…"
                       Foreground="{DynamicResource PopupFgBright}" FontSize="12"
                       Margin="8,0,8,8" TextWrapping="Wrap"/>
            <StackPanel x:Name="ActionHost"/>
            <Border Background="{DynamicResource PopupSeparator}" Height="1" Margin="8,6"/>
            <TextBlock Text="Recent Items" Style="{StaticResource PopupSection}" Margin="8,2,8,4"/>
            <StackPanel x:Name="RecentHost"/>
            <Border Background="{DynamicResource PopupSeparator}" Height="1" Margin="8,6"/>
            <StackPanel x:Name="PowerHost"/>
        </StackPanel>
    </Border>
</Window>
