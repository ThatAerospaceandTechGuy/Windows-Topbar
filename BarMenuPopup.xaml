<Window x:Class="TopBar.BarMenuPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu"
        Width="284" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}" Padding="8,8">
        <StackPanel>
            <TextBlock x:Name="MenuTitle" Text="Menu"
                       Style="{StaticResource PopupSection}"
                       Margin="8,2,8,8"/>
            <StackPanel x:Name="ItemHost"/>
        </StackPanel>
    </Border>
</Window>
