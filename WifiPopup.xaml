<Window x:Class="TopBar.WifiPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi"
        Width="364" SizeToContent="Height" MaxHeight="624"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}" Padding="{StaticResource ContentPad}">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Wi-Fi" Style="{StaticResource PopupHeader}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" x:Name="WifiToggle" Style="{StaticResource Pill}" Margin="0,0,8,0"
                        MouseLeftButtonUp="WifiToggle_Click">
                    <TextBlock x:Name="WifiText" Text="…" Foreground="{DynamicResource PopupFgNormal}" FontSize="12"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Pill}" MouseLeftButtonUp="Rescan_Click">
                    <TextBlock Text="Rescan" Foreground="{DynamicResource PopupFgNormal}" FontSize="12"/>
                </Border>
            </Grid>

            <Border Background="{DynamicResource PopupSeparator}" Height="1" Margin="0,0,0,10"/>

            <TextBlock x:Name="StatusText" Text="Scanning…"
                       Foreground="{DynamicResource PopupFgBright}" FontSize="12.5"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>

            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NetworkHost"/>
            </ScrollViewer>

            <!-- Password entry -->
            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Foreground="{DynamicResource PopupFgLabel}" FontSize="11" Margin="0,0,0,4">
                    <Run Text="Password for "/><Run x:Name="PasswordSsid" Text=""/>
                </TextBlock>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,6"/>
                <TextBlock x:Name="PasswordError" Text="" Foreground="#FF9A9A" FontSize="11" Margin="0,0,0,4" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0" MouseLeftButtonUp="PasswordCancel_Click">
                        <TextBlock Text="Cancel" Foreground="{DynamicResource PopupFgNormal}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" MouseLeftButtonUp="PasswordConnect_Click">
                        <TextBlock Text="Connect" Foreground="{DynamicResource PopupFgNormal}" FontSize="12"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="FooterHost" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
