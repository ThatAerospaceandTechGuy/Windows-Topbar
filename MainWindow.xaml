<Window x:Class="TopBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopBar"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="BarBorder" Background="#01000000" CornerRadius="0">
        <Grid Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- Left: Windows glyph + app name -->
                <ColumnDefinition Width="*" />       <!-- Centre-left: app menus + window title -->
                <ColumnDefinition Width="Auto" />   <!-- Right: status icons -->
            </Grid.ColumnDefinitions>

            <!-- Left: Start glyph + active app menu -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="Transparent" CornerRadius="6"
                        Padding="7,3" Cursor="Hand"
                        MouseLeftButtonUp="AppleButton_Click"
                        MouseEnter="SettingsButton_MouseEnter"
                        MouseLeave="SettingsButton_MouseLeave"
                        x:Name="SettingsButton" ToolTip="Start">
                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="AppleIconPath"
                                  Fill="#CCFFFFFF"
                                  Data="M3 5.3l7.8-1.1V11H3V5.3zm9-1.5l9-1v8.2h-9V3.8zM3 12.5h7.8v7.3L3 18.7v-6.2zm9 0h9v8.7l-9-1.2v-7.5z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Background="Transparent" CornerRadius="6"
                        Padding="8,3" Cursor="Hand"
                        MouseLeftButtonUp="AppButton_Click"
                        MouseEnter="AppButton_MouseEnter"
                        MouseLeave="AppButton_MouseLeave"
                        x:Name="AppButton">
                    <TextBlock x:Name="AppNameText" Text="Finder"
                               Foreground="#CCFFFFFF" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Centre-left: app menus + window title -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="MenuPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Style="{StaticResource MenuTab}" Tag="File" MouseLeftButtonDown="MenuButton_Click"
                            MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave">
                        <TextBlock Text="File" Foreground="#88FFFFFF" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource MenuTab}" Tag="Edit" MouseLeftButtonDown="MenuButton_Click"
                            MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave">
                        <TextBlock Text="Edit" Foreground="#88FFFFFF" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource MenuTab}" Tag="View" MouseLeftButtonDown="MenuButton_Click"
                            MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave">
                        <TextBlock Text="View" Foreground="#88FFFFFF" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource MenuTab}" Tag="Window" MouseLeftButtonDown="MenuButton_Click"
                            MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave">
                        <TextBlock Text="Window" Foreground="#88FFFFFF" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource MenuTab}" Tag="Help" MouseLeftButtonDown="MenuButton_Click"
                            MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave">
                        <TextBlock Text="Help" Foreground="#88FFFFFF" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="WindowTitleText"
                           Foreground="#88FFFFFF" FontSize="12"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="500"/>
            </StackPanel>

            <!-- Right: dynamic icon panel (built in code-behind) -->
            <StackPanel Grid.Column="2" x:Name="RightPanel"
                        Orientation="Horizontal" VerticalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
