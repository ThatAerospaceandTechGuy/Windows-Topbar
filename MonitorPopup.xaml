<Window x:Class="TopBar.MonitorPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Monitor"
        Width="354" SizeToContent="Height" MaxHeight="584"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Border Background="#01000000" CornerRadius="{StaticResource PopupRadius}" Padding="{StaticResource ContentPad}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel>
                <TextBlock x:Name="MonitorTitle" Text="CPU" Style="{StaticResource PopupHeader}" Margin="0,0,0,10"/>
                <StackPanel x:Name="DetailHost"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
